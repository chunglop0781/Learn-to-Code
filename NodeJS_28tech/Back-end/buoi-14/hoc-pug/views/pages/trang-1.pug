    - 
        const infoUser = {
            fullName: "Le Van A",
            email: "levana@gmail.com",
            age: 18,
            statusOnline: true,
            status: "active"
        };

    div Họ tên: #{infoUser.fullName}
    div Email: #{infoUser.email}
    if(infoUser.age >= 18)
      div Tuổi: #{infoUser.age}
    else
      div Tuổi: Dưới 18
    //- if(infoUser.statusOnline)
    //-   div Trạng thái: Online
    //- else
    //-   div Trạng thái: Offline
    div #{infoUser.statusOnline ? "Online": "Offline"}
    if(infoUser.status == "initial")
        div(class="badge badge-blue") Khởi tạo
    else if(infoUser.status == "active")
        div(class="badge badge-green") Hoạt động
    else if(infoUser.status == "inactive")
        div(class="badge badge-gray") Dừng hoạt động
    else if(infoUser.status == "busy")
        div(class="badge badge-orange") Đang bận
    else if(infoUser.status == "locked")
        div(class="badge badge-red") Bị khóa

    - 
        const userList = [
            { fullName: 'Le Van A', age: 18 },
            { fullName: 'Le Van B', age: 20 },
            { fullName: 'Le Van C', age: 22 }
        ];

    div(class="user-list")
        each item, index in userList
            div(class="user-item")
                | #{index + 1}. #{item.fullName} (#{item.age} tuổi)

